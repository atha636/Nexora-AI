# ---- Backend (copy to backend/.env) ----
ENVIRONMENT=development
# Supabase Postgres (Project Settings -> Database -> Connection string, use the psycopg form):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./nexora_dev.db
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (copy to frontend/.env) ----
VITE_API_URL=http://localhost:8000/api/v1

# NEVER put the Supabase service-role key or any API secret in a VITE_ variable.
